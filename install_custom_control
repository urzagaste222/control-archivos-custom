#!/bin/bash

set -e

clear

echo "[+] HTTP Custom Secure Installer"

# =========================
# PEDIR DOMINIO
# =========================

read -p "Dominio/subdominio apuntando a esta VPS: " DOMAIN

if [ -z "$DOMAIN" ]; then
    echo "Dominio inválido"
    exit 1
fi

# =========================
# INSTALAR PAQUETES
# =========================

apt update -y

apt install nginx php-fpm php-cli certbot python3-certbot-nginx curl -y

PHP_VERSION=$(php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;")

# =========================
# CREAR DIRECTORIOS
# =========================

mkdir -p /var/www/private

touch /var/www/private/access.log

chmod 777 /var/www/private/access.log

mkdir -p /var/www/private

touch /var/www/private/tokens.db
touch /var/www/private/downloads.log

chmod 666 /var/www/private/tokens.db
chmod 666 /var/www/private/downloads.log

# =========================
# ARCHIVOS HC
# =========================

touch /var/www/private/config.hc

touch /var/www/private/token-conf.hc

# =========================
# GET NORMAL
# =========================

cat > /var/www/html/get.php << 'EOF'
<?php

$ip = $_SERVER['REMOTE_ADDR'];
$user_agent = $_SERVER['HTTP_USER_AGENT'] ?? '';
$accept = $_SERVER['HTTP_ACCEPT'] ?? '';
$method = $_SERVER['REQUEST_METHOD'] ?? '';

$log_file = "/var/www/private/access.log";
$file = "/var/www/private/config.hc";

$limit_time = 43200;
$current_time = time();


// =========================
// BLOQUEOS
// =========================

if (preg_match('/Mozilla|Chrome|Safari|Firefox|Edg/i', $user_agent)) {
    http_response_code(403);
    exit;
}

if (preg_match('/curl|Wget/i', $user_agent)) {
    http_response_code(403);
    exit;
}

if (strpos($accept, 'text/html') !== false) {
    http_response_code(403);
    exit;
}

if ($method !== 'GET') {
    http_response_code(403);
    exit;
}


// =========================
// RATE LIMIT
// =========================

if (file_exists($log_file)) {

    $lines = file($log_file, FILE_IGNORE_NEW_LINES);
    $new_lines = [];

    foreach ($lines as $line) {

        if (trim($line) == '') continue;

        list($saved_ip, $timestamp) = explode('|', $line);

        if (($current_time - $timestamp) < $limit_time) {
            $new_lines[] = $line;
        }

        if ($saved_ip === $ip) {

            if (($current_time - $timestamp) < $limit_time) {

                http_response_code(429);
                exit;
            }
        }
    }

    file_put_contents($log_file, implode("\n", $new_lines) . "\n");
}

file_put_contents($log_file, "$ip|$current_time\n", FILE_APPEND);


// =========================
// SERVIR ARCHIVO
// =========================

if (!file_exists($file)) {

    http_response_code(404);
    exit;
}

header('Content-Type: application/octet-stream');
header('Content-Disposition: attachment; filename="'.rand(1000,9999).'.hc"');
header('Content-Length: ' . filesize($file));

readfile($file);

exit;

?>
EOF

# =========================
# GET TOKEN
# =========================

cat > /var/www/html/token.php << 'EOF'
<?php

$token = $_GET['token'] ?? '';

$tokens_file = "/var/www/private/tokens.db";
$download_log = "/var/www/private/downloads.log";

$file = "/var/www/private/token-conf.hc";

if (!file_exists($tokens_file)) {
    http_response_code(403);
    exit;
}

$lines = file($tokens_file, FILE_IGNORE_NEW_LINES);

$new_lines = [];

$valid = false;

foreach ($lines as $line) {

    if (trim($line) == '') continue;

    list($saved_token, $max_dl, $used_dl, $expire) = explode('|', $line);

    if ($saved_token == $token) {

        if (time() > $expire) {
            continue;
        }

        if ($used_dl >= $max_dl) {
            continue;
        }

        $used_dl++;

        $valid = true;

        $ip = $_SERVER['REMOTE_ADDR'];

        file_put_contents(
            $download_log,
            date("Y-m-d H:i:s") .
            " | IP: $ip | TOKEN: $token\n",
            FILE_APPEND
        );
    }

    $new_lines[] = "$saved_token|$max_dl|$used_dl|$expire";
}

file_put_contents($tokens_file, implode("\n", $new_lines) . "\n");

if (!$valid) {

    http_response_code(403);
    exit;
}

if (!file_exists($file)) {

    http_response_code(404);
    exit;
}

header('Content-Type: application/octet-stream');

header(
'Content-Disposition: attachment; filename="'.rand(1000,9999).'.hc"'
);

header('Content-Length: ' . filesize($file));

readfile($file);

exit;
?>
EOF

# =========================
# NGINX
# =========================

cat > /etc/nginx/sites-available/default << 'EOF'
server {

    listen 80 default_server;
    listen [::]:80 default_server;

    server_name $DOMAIN;

    root /var/www/html;

    index index.php index.html index.htm;

    location / {

        try_files \$uri \$uri/ =404;
    }

    location ~ \.php$ {

        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php${PHP_VERSION}-fpm.sock;
    }

    location ~ /\.ht {

        deny all;
    }
}
EOF

# =========================
# HC MANAGER
# =========================

cat > /usr/local/bin/hc-manager << 'EOF'
#!/bin/bash

DOMAIN=$(grep server_name /etc/nginx/sites-enabled/default | head -n1 | awk '{print $2}' | sed 's/;//')

PRIVATE_DIR="/var/www/private"
TOKENS_FILE="$PRIVATE_DIR/tokens.db"
DOWNLOAD_LOG="$PRIVATE_DIR/downloads.log"

mkdir -p $PRIVATE_DIR

touch $TOKENS_FILE
touch $DOWNLOAD_LOG

clear

while true; do

echo "======================================="
echo " HTTP CUSTOM MANAGER"
echo "======================================="
echo
echo "1) Generar link SIN token"
echo "2) Generar link CON token"
echo "3) Ver descargas"
echo "4) Mover archivo HC"
echo "5) Listar archivos HC"
echo "6) Ver tokens activos"
echo "7) Eliminar token"
echo "0) Salir"
echo
read -p "Selecciona una opción: " opt

case $opt in

1)

clear

echo "======================================="
echo "CONFIG PUBLICA"
echo "======================================="
echo

if [ ! -f "$PRIVATE_DIR/config.hc" ]; then
    echo "[!] No existe:"
    echo "$PRIVATE_DIR/config.hc"
    echo
    read -p "ENTER para continuar..."
    continue
fi

chmod 644 "$PRIVATE_DIR/config.hc"

echo "[+] LINK:"
echo
echo "https://$DOMAIN/get.php"
echo
read -p "ENTER para continuar..."
;;

2)

clear

echo "======================================="
echo "CONFIG TOKEN"
echo "======================================="
echo

if [ ! -f "$PRIVATE_DIR/token-conf.hc" ]; then
    echo "[!] No existe:"
    echo "$PRIVATE_DIR/token-conf.hc"
    echo
    read -p "ENTER para continuar..."
    continue
fi

read -p "Cantidad máxima de descargas: " MAXDL

read -p "Minutos de duración: " MINUTES

TOKEN=$(tr -dc A-Za-z0-9 </dev/urandom | head -c 12)

EXPIRE=$(date +%s)
EXPIRE=$((EXPIRE + MINUTES*60))

echo "$TOKEN|$MAXDL|0|$EXPIRE" >> $TOKENS_FILE

chmod 644 "$PRIVATE_DIR/token-conf.hc"

echo
echo "[+] TOKEN CREADO"
echo
echo "https://$DOMAIN/token.php?token=$TOKEN"
echo
echo "Descargas máximas: $MAXDL"
echo "Expira en: $MINUTES minutos"
echo
read -p "ENTER para continuar..."
;;

3)

clear

echo "======================================="
echo "DESCARGAS"
echo "======================================="
echo

if [ ! -s "$DOWNLOAD_LOG" ]; then
    echo "Sin registros"
else
    cat $DOWNLOAD_LOG
fi

echo
read -p "ENTER para continuar..."
;;

4)

clear

echo "======================================="
echo "MOVER ARCHIVO HC"
echo "======================================="
echo

echo "[+] Archivos disponibles:"
echo

find . -maxdepth 1 -name "*.hc"

echo
read -p "Nombre del archivo: " FILE

if [ ! -f "$FILE" ]; then
    echo
    echo "[!] Archivo no encontrado"
    echo
    read -p "ENTER para continuar..."
    continue
fi

echo
echo "1) Config pública"
echo "2) Config token"
echo

read -p "Destino: " DEST

if [ "$DEST" == "1" ]; then

    cp "$FILE" "$PRIVATE_DIR/config.hc"

    echo
    echo "[+] Movido a:"
    echo "$PRIVATE_DIR/config.hc"

elif [ "$DEST" == "2" ]; then

    cp "$FILE" "$PRIVATE_DIR/token-conf.hc"

    echo
    echo "[+] Movido a:"
    echo "$PRIVATE_DIR/token-conf.hc"

else

    echo
    echo "[!] Opción inválida"

fi

echo
read -p "ENTER para continuar..."
;;

5)

clear

echo "======================================="
echo "ARCHIVOS HC"
echo "======================================="
echo

find $PRIVATE_DIR -name "*.hc"

echo
read -p "ENTER para continuar..."
;;

6)

clear

echo "======================================="
echo "TOKENS ACTIVOS"
echo "======================================="
echo

if [ ! -s "$TOKENS_FILE" ]; then

    echo "No hay tokens"

else

    while IFS='|' read TOKEN MAX USED EXP; do

        NOW=$(date +%s)

        REST=$((EXP - NOW))

        if [ $REST -lt 0 ]; then
            STATUS="EXPIRADO"
        else
            STATUS="$((REST/60)) min restantes"
        fi

        echo
        echo "TOKEN: $TOKEN"
        echo "MAX: $MAX"
        echo "USADOS: $USED"
        echo "ESTADO: $STATUS"
        echo

    done < $TOKENS_FILE

fi

echo
read -p "ENTER para continuar..."
;;

7)

clear

echo "======================================="
echo "ELIMINAR TOKEN"
echo "======================================="
echo

cat $TOKENS_FILE

echo
read -p "Token a eliminar: " DEL

grep -v "^$DEL|" $TOKENS_FILE > /tmp/tokens.tmp

mv /tmp/tokens.tmp $TOKENS_FILE

echo
echo "[+] Token eliminado"
echo

read -p "ENTER para continuar..."
;;

0)

clear
exit
;;

*)

echo
echo "[!] Opción inválida"
sleep 1
;;

esac

clear

done
EOF

chmod +x /usr/local/bin/hc-manager

# =========================
# RESTART
# =========================

systemctl restart php${PHP_VERSION}-fpm
systemctl restart nginx

# =========================
# SSL
# =========================

echo
echo "[+] Configurando HTTPS..."

certbot --nginx --non-interactive --agree-tos --register-unsafely-without-email -d $DOMAIN

systemctl restart nginx

# =========================
# FINAL
# =========================

clear

echo
echo "[+] INSTALACION COMPLETADA"
echo

echo "======================================="
echo "CONFIG NORMAL (SIN TOKEN)"
echo "======================================="
echo
echo "URL:"
echo "https://$DOMAIN/get.php"
echo
echo "ARCHIVO:"
echo "/var/www/private/config.hc"
echo

echo "======================================="
echo "CONFIG PRIVADA (TOKEN)"
echo "======================================="
echo
echo "URL:"
echo "https://$DOMAIN/token.php?token=TOKEN123"
echo
echo "ARCHIVO:"
echo "/var/www/private/token-conf.hc"
echo

echo "======================================="
echo "REEMPLAZAR CONFIGS"
echo "======================================="
echo
echo "NORMAL:"
echo "cp nuevo.hc /var/www/private/config.hc"
echo
echo "TOKEN:"
echo "cp privado.hc /var/www/private/token-conf.hc"
echo

echo "======================================="
echo "[+] HC Manager instalado"
echo "======================================="
echo
echo "Ejecutar con:"
echo
echo "hc-manager"
echo
